__pycache__/
*.pyc
.venv/
node_modules/
.DS_Store
changed-sources.tsv
_meta/.cache/
# transient batch-ingest progress log (not corpus content)
_meta/catalog/ors-ingest-log.txt

# Deploy-time secrets: this repo's own MCP server is deployed via a Cloudflare
# Tunnel whose credentials live in ~/.cloudflared/ on the host, never in-repo (see
# docs/mcp.md). These patterns are a safety net in case one is ever dropped here
# by habit -- they must never be committed.
.cloudflared/
*.pem
cert.pem
cloudflared-*.json
tunnel-*.json
*.env
.env.*

# GitHub Pages build output (generated by src/build_site.py, deployed by the pages workflow)
site/

# Batch-run bookkeeping for src/analyze_conflicts.py (batch ids, bundle manifests).
# Reproducible from the catalog + graph; nothing here is an input to CI.
_meta/.cache/conflict-runs/

# Semantic vector index. Not committed: it is a derived artifact, nothing in CI or Pages
# consumes it (build_embeddings.py --check soft-passes when absent, and the MCP server
# falls back to keyword search), and at corpus scale it exceeds GitHub's 100 MiB per-file
# limit. Keeping it out of git also frees the build to use the best available model
# (sentence-transformers/bge-large on a GPU host) instead of whichever one fits a size cap.
# Build locally to enable semantic search:  python3 src/build_embeddings.py
_meta/embeddings/*
# ...except the 2-D projection, which is small and IS a committed CI input (build_topic_map).
!_meta/embeddings/projection.2d.json

# Local-model evaluation output (reports, not corpus content).
_meta/.cache/conflict-eval/
